<% layout('layouts/boilerplate') %>

<div class="form-page">
  <h1>List Your Item</h1>
  <p>Fill in the details to start earning from your asset.</p>

  <div class="form-card">
    <form action="/listings" method="POST" enctype="multipart/form-data">
      <div class="form-group">
        <label>Title</label>
        <input type="text" name="listing[title]" placeholder="e.g. Royal Enfield Classic 350" required/>
      </div>
      <div class="form-group">
        <label>Description</label>
        <textarea name="listing[description]" rows="4"
          placeholder="Describe your item, condition, what's included..." required></textarea>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="form-group">
          <label>Category</label>
          <select name="listing[category]">
            <option>Bikes</option>
            <option>Cars</option>
            <option>Scooters</option>
            <option>Cameras</option>
            <option>Laptops</option>
            <option>Projectors</option>
            <option>Drones</option>
            <option>Audio</option>
          </select>
        </div>
        <div class="form-group">
          <label>Price per Day (₹)</label>
          <input type="number" name="listing[price]" placeholder="e.g. 800" min="1" required/>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem;">
        <div class="form-group">
          <label>City / Location</label>
          <input type="text" name="listing[location]" placeholder="e.g. Pune" required/>
        </div>
        <div class="form-group">
          <label>Country</label>
          <input type="text" name="listing[country]" value="India" required/>
        </div>
      </div>
      <div class="form-group">
        <label>Item Photo</label>
        <input type="file" name="listing[image]" accept="image/*" required/>
      </div>
      <button type="submit" class="btn-book">🚀 Publish Listing</button>
    </form>
  </div>
</div>