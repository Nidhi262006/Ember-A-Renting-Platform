<% layout('layouts/boilerplate') %>

<%
  // Accounts created before `username` existed on the User model have only an
  // email, and seeded listings have no owner at all, so reach for a name through
  // fallbacks rather than dereferencing something that isn't there.
  const displayName = (person, fallback) =>
    (person && (person.username || person.email)) || fallback;
  const initialOf = (person, fallback) =>
    displayName(person, fallback).charAt(0).toUpperCase();
  const imageUrl = (listing.image && listing.image.url)
    || "https://placehold.co/800x600?text=No+Image";
  const pricePerDay = listing.price || 0;
  const booked = bookedRanges || [];
%>

<div style="max-width:1100px;margin:1rem auto;padding:0 2rem;">
  <nav style="font-size:0.85rem;color:#78716C;margin-bottom:1.5rem;">
    <a href="/listings" style="color:#F97316;text-decoration:none;">Home</a> › 
    <span><%= listing.category || 'Listings' %></span> › 
    <span><%= listing.title || 'Untitled listing' %></span>
  </nav>
</div>

<div class="show-container">
  <!-- LEFT -->
  <div>
    <div class="show-images">
      <img src="<%= imageUrl %>" alt="<%= listing.title || 'Listing photo' %>"
           onerror="this.src='https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800'"/>
    </div>

    <div class="show-title"><%= listing.title || 'Untitled listing' %></div>
    <div class="show-meta">
      <span class="badge"><%= listing.category || 'Rental' %></span>
      <span class="badge <%= listing.isAvailable ? 'badge-available' : 'badge-unavailable' %>">
        <%= listing.isAvailable ? '✅ Available' : '🚫 Unavailable' %>
      </span>
      <span>📍 <%= [listing.location, listing.country].filter(Boolean).join(', ') || 'Location not set' %></span>
      <span>⭐ 4.9 (27 reviews)</span>
    </div>

    <% if (listing.owner) { %>
      <div style="display:flex;align-items:center;gap:0.8rem;padding:1rem;background:#F5F5F4;border-radius:12px;margin-bottom:1.5rem;">
        <div style="width:42px;height:42px;border-radius:50%;background:#F97316;display:flex;align-items:center;justify-content:center;color:white;font-weight:700;">
          <%= initialOf(listing.owner, 'Host') %>
        </div>
        <div>
          <div style="font-weight:700;font-size:0.9rem;"><%= displayName(listing.owner, 'Host') %></div>
          <div style="font-size:0.8rem;color:#78716C;">Member since 2023 · ⭐ 4.9</div>
        </div>
      </div>
    <% } %>

    <p class="show-description"><%= listing.description || 'No description yet.' %></p>

    <!-- REVIEWS SECTION -->
    <div class="reviews-section">

  <% if (currUser) { %>
  <div class="review-form-card">
    <h4>Leave a Review</h4>
    <form action="/listings/<%= listing._id %>/reviews" method="POST">
      <div class="form-group">
        <label>Your Rating</label>
        <div class="star-rating">
          <input type="radio" id="rate5" name="review[rating]" value="5"/><label for="rate5">&#9733;</label>
          <input type="radio" id="rate4" name="review[rating]" value="4"/><label for="rate4">&#9733;</label>
          <input type="radio" id="rate3" name="review[rating]" value="3"/><label for="rate3">&#9733;</label>
          <input type="radio" id="rate2" name="review[rating]" value="2"/><label for="rate2">&#9733;</label>
          <input type="radio" id="rate1" name="review[rating]" value="1"/><label for="rate1">&#9733;</label>
        </div>
      </div>
      <div class="form-group">
        <label>Your Review</label>
        <textarea name="review[comment]" rows="3" placeholder="Share your experience..."></textarea>
      </div>
      <button type="submit" class="btn-book" style="width:auto;padding:0.7rem 1.5rem;">Post Review</button>
    </form>
  </div>
  <% } %>

  <% if (listing.reviews && listing.reviews.length > 0) { %>
  <h4 style="margin:2rem 0 1rem;">Recent Feedbacks</h4>
  <div class="feedback-list">
    <% for (let review of listing.reviews) { %>
    <div class="feedback-card">
      <div class="feedback-avatar">
        <%= initialOf(review.author, 'User') %>
      </div>
      <div class="feedback-body">
        <div class="feedback-header">
          <span class="feedback-name"><%= displayName(review.author, 'User') %></span>
          <div class="feedback-stars">
            <% for (let i = 1; i <= 5; i++) { %>
              <span class="<%= i <= review.rating ? 'star filled' : 'star' %>">&#9733;</span>
            <% } %>
          </div>
        </div>
        <p class="feedback-comment"><%= review.comment %></p>
        <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
        <form action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE" method="POST" style="margin-top:0.4rem;">
          <button type="submit" class="delete-review-btn">&#128465; Delete</button>
        </form>
        <% } %>
      </div>
    </div>
    <% } %>
  </div>
  <% } %>

</div>
  </div>

  <!-- RIGHT: BOOKING CARD -->
  <div>
    <%
      const isOwnListing = currUser && listing.owner && currUser._id.equals(listing.owner._id);
      const today = new Date().toISOString().split("T")[0];
    %>
    <div class="booking-card">
      <div class="big-price">
        ₹<%= pricePerDay.toLocaleString('en-IN') %> <span>/ day</span>
      </div>

      <% if (booked.length) { %>
        <div class="booked-dates">
          <strong>Already booked</strong>
          <ul>
            <% for (let range of booked) { %>
              <li><%= formatDate(range.startDate) %> → <%= formatDate(range.endDate) %></li>
            <% } %>
          </ul>
        </div>
      <% } %>

      <% if (isOwnListing) { %>
        <p class="booking-note">This is your own listing, so you can't book it.</p>
      <% } else if (!listing.isAvailable) { %>
        <p class="booking-note booking-note-off">
          The owner has marked this item unavailable, so it can't be booked right now.
        </p>
      <% } else if (!currUser) { %>
        <a href="/login" class="btn-book" style="text-align:center;display:block;text-decoration:none;">
          Login to Book
        </a>
      <% } else { %>
        <form action="/bookings" method="POST">
          <input type="hidden" name="booking[listing]" value="<%= listing._id %>"/>

          <div class="form-group">
            <label>From</label>
            <input type="date" name="booking[startDate]" id="startDate" min="<%= today %>" required/>
          </div>
          <div class="form-group">
            <label>To</label>
            <input type="date" name="booking[endDate]" id="endDate" min="<%= today %>" required/>
          </div>

          <div class="booking-summary">
            <div class="summary-row">
              <span>₹<%= pricePerDay.toLocaleString('en-IN') %> × <span id="dayCount">0</span> day(s)</span>
              <span id="rentalTotal">₹0</span>
            </div>
            <div class="summary-row muted">
              <span>Security deposit (refundable)</span>
              <span>₹500</span>
            </div>
          </div>

          <button type="submit" class="btn-book">Request to Book</button>
        </form>
      <% } %>

      <a href="#" class="btn-outline">💬 Chat with Owner</a>

      <% if (isOwnListing) { %>
        <div style="margin-top:1rem;padding-top:1rem;border-top:1px solid #E7E5E4;">
          <form action="/listings/<%= listing._id %>/availability" method="POST">
            <button type="submit" class="btn-outline" style="margin-bottom:0.5rem;">
              <%= listing.isAvailable ? '⏸ Pause Bookings' : '▶️ Allow Bookings' %>
            </button>
          </form>
          <a href="/listings/<%= listing._id %>/edit" class="btn-outline"
             style="margin-bottom:0.5rem;">✏️ Edit Listing</a>
          <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
            <button type="submit"
              style="width:100%;background:#FFF1F2;color:#BE123C;border:1px solid #FECDD3;border-radius:12px;padding:0.7rem;font-family:inherit;font-weight:600;cursor:pointer;">
              🗑 Delete Listing
            </button>
          </form>
        </div>
      <% } %>
    </div>
  </div>
</div>

<script>
  (() => {
    const startInput = document.getElementById("startDate");
    const endInput = document.getElementById("endDate");
    if (!startInput || !endInput) return;

    const pricePerDay = <%= pricePerDay %>;
    const dayCount = document.getElementById("dayCount");
    const rentalTotal = document.getElementById("rentalTotal");
    const MS_PER_DAY = 1000 * 60 * 60 * 24;

    const updateEstimate = () => {
      // The return date always has to land after the pick-up date.
      if (startInput.value) {
        const earliestReturn = new Date(startInput.value);
        earliestReturn.setUTCDate(earliestReturn.getUTCDate() + 1);
        endInput.min = earliestReturn.toISOString().split("T")[0];
        if (endInput.value && endInput.value <= startInput.value) {
          endInput.value = "";
        }
      }

      const start = new Date(startInput.value);
      const end = new Date(endInput.value);
      const days = end > start ? Math.round((end - start) / MS_PER_DAY) : 0;

      dayCount.textContent = days;
      rentalTotal.textContent = "₹" + (days * pricePerDay).toLocaleString("en-IN");
    };

    startInput.addEventListener("change", updateEstimate);
    endInput.addEventListener("change", updateEstimate);
  })();
</script>