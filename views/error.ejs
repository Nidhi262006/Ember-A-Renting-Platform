<% layout('layouts/boilerplate') %>

<%
  // Read defensively: this page is the last thing standing between a failure and
  // an Express stack trace, so it must not be able to throw itself.
  const code = (typeof statusCode !== "undefined" && statusCode) || 500;
  const detail = (typeof message !== "undefined" && message)
    || "Something went wrong on our end. Please try again in a moment.";
  const trace = typeof stack !== "undefined" ? stack : null;

  const headlines = {
    400: "That didn't look quite right",
    401: "You need to be logged in",
    403: "You can't do that",
    404: "We can't find that page",
    409: "That already exists",
    413: "That was a little too big",
    500: "Something went wrong on our end",
    503: "We're having trouble connecting",
  };
  const headline = headlines[code]
    || (code < 500 ? "That didn't look quite right" : "Something went wrong on our end");
%>

<div class="error-page">
  <div class="error-code"><%= code %></div>
  <h1 class="error-title"><%= headline %></h1>
  <p class="error-message"><%= detail %></p>

  <div class="error-actions">
    <a href="/listings" class="btn-book error-action">Browse rentals</a>
    <a href="#" class="btn-outline error-action"
       onclick="history.back();return false;">Go back</a>
  </div>

  <% if (trace) { %>
    <details class="error-details">
      <summary>Technical details (shown in development only)</summary>
      <pre><%= trace %></pre>
    </details>
  <% } %>
</div>
