# Copy this file to .env and fill in your own values.
# app.js loads it automatically whenever NODE_ENV is not "production".

# Port the server listens on. Defaults to 3000 if unset.
PORT=3000

# MongoDB connection string. Defaults to the local database if unset.
MONGO_URI=mongodb://127.0.0.1:27017/majorproject

# Signs the session cookie. Use a long random string in production.
SESSION_SECRET=replace-me-with-a-long-random-string

# Cloudinary credentials — required for listing image uploads.
# Find them on your Cloudinary dashboard at https://cloudinary.com/console
CLOUD_NAME=your-cloud-name
CLOUD_API_KEY=your-api-key
CLOUD_API_SECRET=your-api-secret
